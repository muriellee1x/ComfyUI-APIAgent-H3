    "I2VA": {"minimum": 1, "maximum": 1},
    "FL2VA": {"minimum": 2, "maximum": 2},
    "L2VA": {"minimum": 1, "maximum": 1},
    "Ref2VA": {"minimum": 1, "maximum": 9}
  },
  "mandatory_rules": [
    "rules/price-effect-system.md",
    "rules/price-effect-profile.json",
    "rules/h3-prompt-writing-base-en.txt",
